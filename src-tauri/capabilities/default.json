{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "updater:default",
    "process:allow-restart"
  ]
}
